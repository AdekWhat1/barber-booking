# Django Production Config
DEBUG=False
DJANGO_SECRET_KEY=generate_new_random_secret_key_here
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_BARBER_CHAT_ID=chat_id_1,chat_id_2
TELEGRAM_INVITE_TOKEN=secret_invite_token_here

# PostgreSQL
POSTGRES_DB=barber_db
POSTGRES_USER=barber_user
POSTGRES_PASSWORD=generate_strong_password
DB_HOST=db
DB_PORT=5432